DEBUG=

# S3 storage for per-user config/summaries (used instead of local disk when
# demoing off t2litdocker01). Get these from the `[miljodata-test]` remote in
# your rclone.conf (`~/.config/rclone/rclone.conf`).
S3_ENDPOINT_URL=https://s3-int-1.nina.no
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=miljodata-test
S3_PREFIX=paper-agent
S3_FORCE_PATH_STYLE=true
